# Configuración de la captura de la cámara (scripts/captura-camara.ps1).
#
# Copia este archivo como `camara.env` EN ESTA MISMA CARPETA y rellénalo.
# `camara.env` está en .gitignore: lleva la contraseña de la cámara y el token de
# subida, y no debe acabar en el repo.

# ── Cámara (red local) ───────────────────────────────────────────────────────
# IP de la cámara. RESÉRVALA en el router por DHCP: si el router se la cambia, la
# captura se cae en silencio y sólo lo notarás porque la foto deja de refrescarse.
CAMERA_IP=192.168.100.X

# Credenciales de la CUENTA DE CÁMARA, que NO es la cuenta TP-Link.
# Se crea en la app Tapo: Configuración del dispositivo → Avanzado → Cuenta de cámara.
# Sin ese paso el RTSP no responde y parece que la cámara no lo soporta.
CAMERA_USER=
CAMERA_PASS=

# stream1 = 2K (la buena) · stream2 = baja resolución.
CAMERA_STREAM=stream1

# ── Servidor ─────────────────────────────────────────────────────────────────
API_URL=https://clima.xe1e.net
# El mismo valor que CAMERA_UPLOAD_TOKEN en el .env del VPS.
UPLOAD_TOKEN=

# ── Ir DIRECTO al VPS, saltándose Cloudflare (opcional) ──────────────────────
# Sólo hace falta si la máquina que captura sale a internet por una IP que Cloudflare
# desafía --p. ej. una VPN de AMPRNet, donde la subida recibe un 403 con
# `cf-mitigated: challenge` y no llega nunca--. Déjalo vacío si subes desde una
# conexión doméstica normal.
#
# Con VPS_IP puesto, el script resuelve el dominio a esa IP y, si el tráfico va por un
# túnel, añade en memoria una ruta por la LAN para sacarlo de ahí (no toca la
# configuración de red de la máquina).
VPS_IP=
# OBLIGATORIO si usas VPS_IP. El certificado del VPS es un Origin Certificate de
# Cloudflare: no lo valida una CA pública, así que en vez de desactivar la validación
# se FIJA la clave pública del servidor. Se obtiene con:
#   openssl s_client -connect <VPS_IP>:443 -servername <dominio> </dev/null 2>/dev/null \
#     | openssl x509 -pubkey -noout | openssl pkey -pubin -outform der \
#     | openssl dgst -sha256 -binary | openssl enc -base64
# Formato: sha256//AAAA...=   (si algún día se renueva el certificado, hay que
# regenerarlo; el error en el log será claro).
TLS_PIN=

# ── Ajustes ──────────────────────────────────────────────────────────────────
# Ancho máximo de la foto que se sube. El 2K de la cámara son ~600 KB por captura y
# la web la muestra a ~1200 px y el kiosco a 1024: a 1600 no se pierde nada visible y
# el histórico del timelapse ocupa un tercio. Se reduce sólo si la imagen es mayor.
MAX_WIDTH=1600

# Reintentos antes de rendirse (con esperas de 5 s, 10 s...). Si aun así falla, no se
# sube nada y el servidor marcará sola la foto anterior como antigua.
RETRIES=3
