[Unit]
Description=Dispara la captura del exterior cada minuto; el script decide si captura (lee /api/camera/capture-config: on/off, horario e intervalo del panel)

[Timer]
# Al arrancar se espera un poco: la red (y la VPN, donde la haya) tarda en asentarse.
OnBootSec=2min
# Cada minuto, pero NO captura cada minuto: captura-camara.sh consulta el panel
# (Admin -> Cámara) y sale sin hacer nada si está apagada, fuera de horario o si
# aún no pasó el intervalo desde la última (.ultima-captura). Así el ritmo se cambia
# desde el panel sin tocar la Pi.
OnUnitActiveSec=1min
AccuracySec=20s

[Install]
WantedBy=timers.target
